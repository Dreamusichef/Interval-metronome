# The Ops Daemon — environment template.
# Copy to .env on the VPS (/opt/ops-daemon/.env) and fill in real values.
# .env is gitignored. NEVER commit real secrets. Values are provisioned by the owner.

# --- Runtime AI (Haiku) ---
# Standalone Anthropic API key. NOT the Max subscription / OAuth. Required only when
# the Pain-Point Miner is enabled (it is the only module that calls Haiku).
ANTHROPIC_API_KEY=

# --- Cockpit (Arcane Sanctum / Lovable Cloud) integration boundary ---
ARCANE_INGEST_URL=
ARCANE_READ_URL=
# Shared secret; must match the DAEMON_API_KEY secret created in Lovable Cloud.
DAEMON_API_KEY=

# --- Email Watch (Kit / ConvertKit, read-only) ---
KIT_API_KEY=

# --- Funnel Watch ---
DOJO_PUBLIC_JSON_URL=https://dreamusichef.github.io/aodhq-dojo-dashboard/dojo-data.public.json
# First Stroke preorder counter — confirm the read method with the owner.
FIRSTSTROKE_SUPABASE_URL=
FIRSTSTROKE_ANON_KEY=

# --- Morning Brief delivery ---
# Discord webhook for #clawdbot-notifications (a passive HTTPS POST; NOT a bot token).
DISCORD_BRIEF_WEBHOOK_URL=

# --- Privacy ---
# Salt used to hash student handles before they ever reach the cockpit. Required when
# the Pain-Point Miner is enabled. Use a long random value; rotating it re-buckets hashes.
DAEMON_HASH_SALT=

# --- Local store ---
# Absolute path to the SQLite store. Defaults to <cwd>/ops.db when unset.
OPS_DB_PATH=/opt/ops-daemon/ops.db

# --- Scheduling (optional overrides) ---
# Cron expressions are evaluated in DAEMON_TZ. Daily cycle runs just after Pulse's
# nightly intake (~22:55 SGT / day boundary 23:00 SGT). Funnel self-gates to weekly.
DAEMON_TZ=Asia/Singapore
DAILY_CRON=10 23 * * *

# --- Module toggles ---
MODULE_EMAIL_ENABLED=true
MODULE_MONEY_ENABLED=true
MODULE_FUNNEL_ENABLED=true
MODULE_PAINPOINTS_ENABLED=true
MODULE_STALEQUEST_ENABLED=true
# Review Watch ships disabled — it cannot run until a review app (Judge.me/Loox) is live.
MODULE_REVIEW_ENABLED=false
